---
import Icon from "./Icon.astro";
import MobileNav from "./react/MobileNav.tsx";
import portfolio from "../data/portfolio.json";

const { meta, socials } = portfolio;

const links = [
  { href: "#about", icon: "user", label: "About" },
  { href: "#experience", icon: "briefcase", label: "Experience" },
  { href: "#projects", icon: "blocks", label: "Projects" },
  { href: "#blog", icon: "book-open", label: "Blog" },
  { href: "#contact", icon: "mail", label: "Contact" },
] as const;
---

<header
  class="sticky top-0 z-40"
  style="background-color: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border);"
>
  <div class="relative mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4 sm:px-6 xl:pr-16">
    <a
      href="#top"
      class="inline-flex shrink-0 items-center gap-1.5 font-extrabold text-base sm:text-lg"
      style="color: var(--text);"
    >
      <Icon name="user" size={18} />
      {meta.name}
    </a>

    <nav
      class="hidden min-w-0 items-center gap-6 whitespace-nowrap text-sm xl:flex"
      style="color: var(--text-muted);"
    >
      {links.map((link) => (
        <a
          href={link.href}
          class="inline-flex items-center gap-1.5 hover:opacity-70 transition-opacity"
        >
          <Icon name={link.icon} size={15} />
          <span>{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="xl:hidden">
      <MobileNav client:load links={[...links]} socials={socials} />
    </div>
  </div>
</header>
