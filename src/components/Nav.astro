---
import SocialLink from "./SocialLink.astro";
import Icon from "./Icon.astro";
import MobileNav from "./react/MobileNav.tsx";
import portfolio from "../data/portfolio.json";
import { evaSvg } from "../lib/eva";

const { meta, socials } = portfolio;

const links = [
  { href: "#about", icon: "person-outline", label: "About" },
  { href: "#experience", icon: "briefcase-outline", label: "Experience" },
  { href: "#projects", icon: "cube-outline", label: "Projects" },
  { href: "#blog", icon: "book-open-outline", label: "Blog" },
  { href: "#contact", icon: "email-outline", label: "Contact" },
] as const;

const mobileLinks = links.map((link) => ({
  href: link.href,
  label: link.label,
  icon: evaSvg(link.icon, {
    width: 18,
    height: 18,
    fill: "currentColor",
    animation: { type: "zoom", hover: true },
  }),
}));

const menuIcon = evaSvg("menu-2-outline", {
  width: 22,
  height: 22,
  fill: "currentColor",
});
const closeIcon = evaSvg("close-outline", {
  width: 22,
  height: 22,
  fill: "currentColor",
});
---

<header
  class="sticky top-0 z-40"
  style="background-color: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border);"
>
  <div class="relative mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4 sm:px-6">
    <a
      href="#top"
      class="eva-parent-hover inline-flex shrink-0 items-center gap-1.5 font-extrabold text-base sm:text-lg"
      style="color: var(--text);"
    >
      <Icon name="person-outline" size={18} animation="pulse" />
      {meta.name}
    </a>

    <nav
      class="hidden min-w-0 items-center gap-6 whitespace-nowrap text-sm lg:flex"
      style="color: var(--text-muted);"
    >
      {links.map((link) => (
        <a
          href={link.href}
          class="eva-parent-hover inline-flex items-center gap-1.5 hover:opacity-70 transition-opacity"
        >
          <Icon name={link.icon} size={15} animation="zoom" />
          <span>{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="hidden shrink-0 items-center gap-3 pr-10 text-xs sm:text-sm lg:flex" style="color: var(--text-muted);">
      {socials.slice(0, 2).map((s) => (
        <SocialLink label={s.label} url={s.url} />
      ))}
    </div>

    <div class="pr-10 lg:hidden">
      <MobileNav
        client:load
        links={mobileLinks}
        socials={[...socials]}
        menuIcon={menuIcon}
        closeIcon={closeIcon}
      />
    </div>
  </div>
</header>
