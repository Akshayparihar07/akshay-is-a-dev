---
import Icon from "./Icon.astro";
import { socialIcon } from "../lib/icons";

interface Props {
  label: string;
  url: string;
}

const { label, url } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-1.5 capitalize hover:opacity-70 transition-opacity"
>
  <Icon name={socialIcon(label)} size={16} />
  <span>{label}</span>
</a>
