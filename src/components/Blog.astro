---
import Container from "./Container.astro";
import SectionEyebrow from "./SectionEyebrow.astro";
import Icon from "./Icon.astro";
import portfolio from "../data/portfolio.json";
import BlurFade from "./react/BlurFade.tsx";

const { blog } = portfolio;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

<section id="blog" class="py-14 sm:py-20" style="border-top: 1px solid var(--border);">
  <Container>
    <BlurFade client:visible>
      <SectionEyebrow icon="book-open">// writing</SectionEyebrow>
      <h2 class="mb-10 text-2xl font-extrabold sm:text-3xl" style="color: var(--text);">
        Latest posts
      </h2>
    </BlurFade>

    <ul>
      {blog.map((post, i) => (
        <BlurFade
          client:visible
          delay={i * 0.06}
          as="li"
          className="border-t border-t-[var(--border)] first:border-t-0"
        >
          <a href={post.url} class="group flex items-start gap-3 py-5">
            <span class="mt-1 shrink-0" style="color: var(--accent-from);">
              <Icon name="clipboard-list" size={18} />
            </span>
            <span class="min-w-0 flex-1">
              <p class="inline-flex items-center gap-1.5 text-xs font-medium" style="color: var(--text-muted);">
                <Icon name="calendar" size={13} />
                {formatDate(post.date)}
              </p>
              <h3
                class="mt-1 text-lg font-bold transition-colors sm:text-xl"
                style="color: var(--text);"
              >
                {post.title}
              </h3>
              <p class="mt-1 text-sm sm:text-base" style="color: var(--text-muted);">
                {post.excerpt}
              </p>
            </span>
            <span
              class="mt-1 hidden shrink-0 opacity-40 transition-opacity group-hover:opacity-100 sm:inline-flex"
              style="color: var(--accent-from);"
              aria-hidden="true"
            >
              <Icon name="arrow-right" size={20} />
            </span>
          </a>
        </BlurFade>
      ))}
    </ul>
  </Container>
</section>
