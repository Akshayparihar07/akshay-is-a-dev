---
import Container from "./Container.astro";
import SectionEyebrow from "./SectionEyebrow.astro";
import Icon from "./Icon.astro";
import portfolio from "../data/portfolio.json";
import BlurFade from "./react/BlurFade.tsx";
import { skillIcon } from "../lib/eva";

const { projects } = portfolio;
---

<section id="projects" class="py-14 sm:py-20" style="border-top: 1px solid var(--border);">
  <Container>
    <BlurFade client:visible>
      <SectionEyebrow icon="cube-outline">// projects</SectionEyebrow>
      <h2 class="mb-10 text-2xl font-extrabold sm:text-3xl" style="color: var(--text);">
        Stuff I've shipped
      </h2>
    </BlurFade>

    <div class="flex flex-col">
      {projects.map((project, i) => (
        <BlurFade
          client:visible
          delay={i * 0.08}
          className={i === projects.length - 1 ? undefined : "mb-12"}
        >
          <article
            class="overflow-hidden rounded-2xl border transition-transform duration-200 hover:-translate-y-1"
            style="border-color: var(--border); background-color: var(--bg-alt);"
          >
            <img
              src={project.image}
              alt={`${project.name} preview`}
              class="aspect-[16/9] w-full object-cover"
              width="960"
              height="540"
            />
            <div class="p-5 sm:p-6">
              <h3 class="inline-flex items-center gap-2 text-lg font-bold sm:text-xl" style="color: var(--text);">
                <span style="color: var(--accent-from);">
                  <Icon name="folder-outline" size={18} animation="zoom" />
                </span>
                {project.name}
              </h3>
              <p class="mt-2 text-sm sm:text-base" style="color: var(--text-muted);">
                {project.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span
                    class="eva-parent-hover inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs"
                    style="border-color: var(--border); color: var(--text-muted);"
                  >
                    <Icon name={skillIcon(tag)} size={12} animation="zoom" />
                    {tag}
                  </span>
                ))}
              </div>
              <div class="mt-4 flex flex-wrap gap-5 text-sm font-bold">
                <a
                  href={project.liveUrl}
                  class="eva-parent-hover inline-flex items-center gap-1.5"
                  style="color: var(--accent-from);"
                >
                  <Icon name="globe-2-outline" size={16} animation="zoom" />
                  Live
                </a>
                <a
                  href={project.codeUrl}
                  class="eva-parent-hover inline-flex items-center gap-1.5"
                  style="color: var(--accent-to);"
                >
                  <Icon name="github-outline" size={16} animation="zoom" />
                  Code
                </a>
              </div>
            </div>
          </article>
        </BlurFade>
      ))}
    </div>
  </Container>
</section>
