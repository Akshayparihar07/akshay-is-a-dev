---
import Container from "./Container.astro";
import SectionEyebrow from "./SectionEyebrow.astro";
import Icon from "./Icon.astro";
import portfolio from "../data/portfolio.json";
import BlurFade from "./react/BlurFade.tsx";
import { skillIcon } from "../lib/icons";

const { about } = portfolio;
---

<section id="about" class="py-14 sm:py-20">
  <Container>
    <BlurFade client:visible>
      <SectionEyebrow icon="user">// about</SectionEyebrow>
      <h2 class="text-2xl font-extrabold sm:text-3xl" style="color: var(--text);">
        Who's behind the keyboard
      </h2>
      <p class="mt-4 text-base sm:text-lg" style="color: var(--text-muted);">
        {about.bio}
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        {about.skills.map((skill) => (
          <span
            class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs sm:text-sm"
            style="border-color: var(--border); color: var(--text);"
          >
            <Icon name={skillIcon(skill)} size={14} />
            {skill}
          </span>
        ))}
      </div>
    </BlurFade>
  </Container>
</section>
